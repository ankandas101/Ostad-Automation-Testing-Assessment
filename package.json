{
  "name": "ostad-automation-testing-assessment",
  "version": "1.0.0",
  "description": "SauceDemo UI Automation Testing using Playwright",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "q1": "playwright test tests/q1-locked-user.spec.js",
    "q2": "playwright test tests/q2-standard-user.spec.js",
    "q3": "playwright test tests/q3-performance-user.spec.js",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean",
    "allure:open": "allure open",
    "allure": "npm run allure:generate && npm run allure:open"
  },
  "keywords": [
    "playwright",
    "automation",
    "qa",
    "javascript",
    "allure"
  ],
  "author": "Ankan Das",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "allure-playwright": "^3.10.2"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0"
  }
}
